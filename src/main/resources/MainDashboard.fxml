<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sportsmanager.MainDashboardController">
   <children>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="300.0" VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="UserTeamName" text="Label" />
            <Label fx:id="LeagueName" text="Label" />
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
      <HBox prefHeight="231.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
         <children>
            <ListView fx:id="playerList" prefHeight="302.0" prefWidth="283.0" HBox.hgrow="ALWAYS" />
            <TableView fx:id="standings" editable="true" prefHeight="302.0" prefWidth="320.0" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="teamNames" prefWidth="75.0" text="C1" />
                <TableColumn fx:id="points" prefWidth="75.0" text="C2" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onAction="#handleSaveAndExit" text="Save and Exit" />
            <Button mnemonicParsing="false" onAction="#handleSimulateWeek" text="Simulate" />
         </children>
         <VBox.margin>
            <Insets right="20.0" />
         </VBox.margin></HBox>
   </children>
</VBox>
